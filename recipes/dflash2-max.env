# Default max-decode recipe for GSM8K / Q200v2 on a 24 GB RTX 3090.
# DFlash2 sidecar, flash-attn, jinja, VBR default (t4 floor, still F16 until pressure).
# Qwen3.8 metadata block 8 is rewritten to 13 inside buun unless overridden.

RECIPE=dflash2-max
PORT=8080
HOST=0.0.0.0
CTX=8192
N_PARALLEL=1
UBATCH=512
N_GPU_LAYERS=99
N_GPU_LAYERS_DRAFT=99
ALIAS=qwen38-27b-buun
EXTRA_ARGS=--jinja -fa on --fit on --cache-ram 8192
# Leave SPEC_TYPE empty: server detects DFlash2 from the sidecar.
SPEC_TYPE=
# Optional: GGML_DFLASH2_BLOCK_SIZE_OVERRIDE=8
# Optional: GGML_DFLASH_DRAFT_ADAPTIVE=0
# Optional: GGML_DFLASH2_TARGET_MMQ=1
