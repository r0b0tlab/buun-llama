# DFlash2 plus CopySpec. Use on copy-heavy prompts. Quicksort-style probes can slow down.

RECIPE=dflash2-copyspec
PORT=8080
HOST=0.0.0.0
CTX=8192
N_PARALLEL=1
UBATCH=512
N_GPU_LAYERS=99
N_GPU_LAYERS_DRAFT=99
ALIAS=qwen38-27b-buun
EXTRA_ARGS="--jinja -fa on --fit on --cache-ram 8192 --spec-type draft-dflash,copyspec"
SPEC_TYPE=draft-dflash,copyspec
