# RTX 3090 / Qwen3.8-27B EXL3 serving candidate.
# Native server options; client reasoning overrides remain supported.
RECIPE=dflash2-optimized
PORT=8080
HOST=0.0.0.0
CTX=262144
N_PARALLEL=1
UBATCH=512
N_GPU_LAYERS=99
N_GPU_LAYERS_DRAFT=99
ALIAS=qwen38-27b-buun
EXTRA_ARGS='--jinja -fa on --fit off --chat-template-kwargs {"reasoning_effort":"low"} --cache-ram 8192 --vbr-entry t8 --vbr-floor t3 --no-vbr-prompt-cache'
SPEC_TYPE=
export GGML_DFLASH2_BLOCK_SIZE_OVERRIDE=8
export GGML_DFLASH_DRAFT_ADAPTIVE=1
export GGML_DFLASH2_TARGET_MMQ=0
export GGML_DFLASH2_FUSED_CONV=1
